{
  "compilerOptions": {
    "rootDir": "src",
    "skipLibCheck": true,
    "outDir": "dist",
    "lib": ["es2020"],
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "types": ["node"],
    "strict": true
  },
  "include": ["src", "src/custom-types.d.ts"], // include your custom types explicitly
  "exclude": ["node_modules"]
}
