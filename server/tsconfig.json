{
  "compilerOptions": {
    "rootDirs": ["src"], // only directories here
    "outDir": "dist",
    "lib": ["es2020"],
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "types": ["node"],
    "strict": true
  },
  "include": ["src", "src/custom-types.d.ts"] // include your custom types explicitly
}
